"""
날씨 리포트 프로그램 (Open-Meteo API 사용)
- 사용자에게 지역을 입력받음 (기본값: 부산)
- 오늘, 내일, 모레, 글피까지 4일간의 날씨를 오전 6시, 오후 3시 기준으로 표시
- Open-Meteo API 사용 (인증키 불필요, 무료)
- 결과를 JSON 파일로 저장할지 선택 가능
 
GitHub 날씨 리포트 저장소: https://github.com/<내_GitHub_아이디>/weather-report
(위 주소를 본인의 실제 저장소 주소로 바꿔서 제출하세요)
"""
 
import json
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from typing import Optional
 
DEFAULT_CITY = "부산"
FORECAST_DAYS = 4
DAY_LABELS = ["오늘", "내일", "모레", "글피"]
TARGET_HOURS = [(6, "오전", "🌅"), (15, "오후", "🌇")]
 
GEOCODING_URL = "https://geocoding-api.open-meteo.com/v1/search"
FORECAST_URL = "https://api.open-meteo.com/v1/forecast"
 
# WMO 날씨 코드 -> 한글 설명
WEATHER_CODES = {
    0: "맑음", 1: "대체로 맑음", 2: "구름 조금", 3: "흐림",
    45: "안개", 48: "서리 안개",
    51: "약한 이슬비", 53: "이슬비", 55: "강한 이슬비",
    61: "약한 비", 63: "비", 65: "강한 비",
    71: "약한 눈", 73: "눈", 75: "강한 눈",
    80: "약한 소나기", 81: "소나기", 82: "강한 소나기",
    95: "뇌우", 96: "우박을 동반한 뇌우", 99: "강한 우박을 동반한 뇌우",
}
 
 
def fetch_json(url: str, params: dict) -> dict:
    """URL에 파라미터를 붙여 요청하고 JSON 응답을 반환한다. (표준 라이브러리만 사용)"""
    full_url = f"{url}?{urllib.parse.urlencode(params)}"
    with urllib.request.urlopen(full_url, timeout=10) as res:
        return json.loads(res.read().decode("utf-8"))
 
 
def get_coordinates(city: str) -> Optional[dict]:
    """지역 이름으로 위도/경도를 조회한다."""
    params = {"name": city, "count": 1, "language": "ko", "format": "json"}
    try:
        results = fetch_json(GEOCODING_URL, params).get("results")
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as e:
        print(f"❌ 위치 조회 실패: {e}")
        return None
    if not results:
        print(f"❌ '{city}' 지역을 찾을 수 없습니다.")
        return None
    r = results[0]
    return {"name": r.get("name", city), "lat": r["latitude"], "lon": r["longitude"]}
 
 
def get_weather(lat: float, lon: float) -> Optional[dict]:
    """시간별 날씨 데이터를 가져온다."""
    params = {
        "latitude": lat,
        "longitude": lon,
        "hourly": "temperature_2m,precipitation_probability,"
                  "relative_humidity_2m,wind_speed_10m,weather_code",
        "wind_speed_unit": "ms",
        "timezone": "Asia/Seoul",
        "forecast_days": FORECAST_DAYS,
    }
    try:
        return fetch_json(FORECAST_URL, params)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as e:
        print(f"❌ 날씨 조회 실패: {e}")
        return None
 
 
def build_report(data: dict) -> list:
    """API 응답에서 날짜별 오전 6시/오후 3시 데이터를 정리한다."""
    hourly = data["hourly"]
    times = hourly["time"]
    report = []
    for day in range(FORECAST_DAYS):
        entries = []
        day_temps = []
        for hour, ampm, icon in TARGET_HOURS:
            idx = day * 24 + hour
            temp = round(hourly["temperature_2m"][idx])
            day_temps.append(temp)
            entries.append({
                "시간": f"{ampm} {hour:02d}:00",
                "아이콘": icon,
                "날씨": WEATHER_CODES.get(hourly["weather_code"][idx], "알 수 없음"),
                "기온": temp,
                "강수확률": hourly["precipitation_probability"][idx],
                "습도": hourly["relative_humidity_2m"][idx],
                "풍속": round(hourly["wind_speed_10m"][idx]),
            })
        date = datetime.fromisoformat(times[day * 24])
        report.append({
            "날짜": date.strftime("%m.%d."),
            "라벨": DAY_LABELS[day],
            "관측": entries,
            "최저": min(day_temps),
            "최고": max(day_temps),
        })
    return report
 
 
def print_report(city: str, report: list) -> None:
    line = "=" * 70
    sub = "-" * 55
    print(f"\n{line}")
    print(f"🌤️ {city} 날씨 예보 (오전 6시 / 오후 3시 기준)")
    print(line)
    for day in report:
        print(f"\n📅 {day['라벨']} ({day['날짜']})")
        print(sub)
        for e in day["관측"]:
            print(f"  {e['아이콘']} {e['시간']}")
            print(f"    날씨: {e['날씨']}")
            print(f"    기온: {e['기온']} °C")
            print(f"    강수확률: {e['강수확률']}%")
            print(f"    습도: {e['습도']}%")
            print(f"    풍속: {e['풍속']} m/s\n")
        print(f"  🌡️ 일일 기온: 최저 {day['최저']} °C / 최고 {day['최고']} °C\n")
        print(line)
 
 
def save_json(city: str, report: list) -> None:
    filename = f"weather_{city}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
    with open(filename, "w", encoding="utf-8") as f:
        json.dump({"지역": city, "예보": report}, f, ensure_ascii=False, indent=2)
    print(f"💾 {filename} 파일로 저장했습니다.")
 
 
def main() -> None:
    print("🌤️ 날씨 예보 프로그램 (Open-Meteo API)")
    print("-" * 45)
    print(f"오전 6시, 오후 3시 기준으로 {FORECAST_DAYS}일간 날씨를 제공합니다.")
    print("-" * 45)
 
    city = input(f"\n날씨를 확인할 지역을 입력하세요 (기본값: {DEFAULT_CITY}): ").strip()
    city = city or DEFAULT_CITY
 
    loc = get_coordinates(city)
    if not loc:
        return
    print(f"\n📍 {loc['name']} (위도: {loc['lat']:.4f}, 경도: {loc['lon']:.4f}) 의 날씨 정보를 가져옵니다...")
 
    data = get_weather(loc["lat"], loc["lon"])
    if not data:
        return
 
    report = build_report(data)
    print_report(loc["name"], report)
 
    if input("\n날씨 정보를 JSON 파일로 저장하시겠습니까? (y/n): ").strip().lower() == "y":
        save_json(loc["name"], report)
 
 
if __name__ == "__main__":
    main()